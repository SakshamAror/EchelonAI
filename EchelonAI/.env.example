# EchelonAI — Frontend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# Variables prefixed with VITE_ are exposed to the browser bundle.
# Variables without VITE_ are server-side only (Vite dev server / build scripts).

# ── Supabase (frontend — publishable key only, never the secret key) ──────────
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# ── Groq + Tavily (Analyze tab — can also be entered via Settings UI) ─────────
GROQ_API_KEY=gsk_...
TAVILY_API_KEY=tvly-...
GROQ_MODEL=llama-3.3-70b-versatile
AGENT_PYTHON_BIN=.venv/bin/python
